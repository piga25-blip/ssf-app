{
  "name": "ssf-app-reseau",
  "productName": "Application SSF Reseau (test)",
  "version": "13.41.11",
  "description": "Application SSF - Secours Souterrain Français",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && electron-builder build --win",
    "build:dir": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && electron-builder build --win --dir",
    "test:scenario": "node tests/scenario-reference.js",
    "test:scenario:maj": "node tests/scenario-reference.js --maj-reference",
    "test": "node tests/scenario-reference.js && node tests/verif-reouverture.js && node tests/verif-export-import.js && node tests/verif-identifiants.js && node tests/verif-copies-perimees.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.63.0"
  }
}
